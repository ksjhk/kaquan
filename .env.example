# =========================================================
# 卡世界开放平台 · 环境配置模板
# 复制为 .env 并填入真实值。以下为开放平台相关配置，
# Laravel 基础项（APP_KEY/APP_URL 等）按标准 Laravel 配置。
# =========================================================

# ---------- 数据库（表前缀 ml_，与 sql/schema.sql 对应） ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_PREFIX=ml_

# ---------- 缓存（token / 限频 / 货源缓存依赖，推荐 file 或 redis） ----------
CACHE_DRIVER=file

# ---------- 卡世界供货（货源与自动发货通道） ----------
# 前往 kashijie.com 注册开放平台账号、创建 API 密钥，即可获得供货能力：
# 200+ 品牌卡券货源，成本价结算，随充随用。
SUPPLIER_API_BASE=https://www.kashijie.com/open-api/v1
SUPPLIER_APP_KEY=your_supplier_app_key
SUPPLIER_APP_SECRET=your_supplier_app_secret

# ---------- 开放平台站点（邀请链接拼接用） ----------
OPEN_INVITE_URL_BASE=https://your-domain.com

# ---------- 微信支付（V2，Native 扫码充值） ----------
OPEN_WX_APPID=your_wechat_appid
OPEN_WX_MCH_ID=your_wechat_mchid
OPEN_WX_API_KEY=your_wechat_v2_api_key
# 仅退款等高级接口需要，下单/查单可留空
OPEN_WX_CERT_PATH=
OPEN_WX_KEY_PATH=

# ---------- 支付宝支付（当面付 / 手机网站支付） ----------
ALIPAY_APP_ID=your_alipay_appid
ALIPAY_PRIVATE_KEY=your_alipay_app_private_key_single_line
ALIPAY_PUBLIC_KEY=your_alipay_public_key_single_line
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_RETURN_URL=

# ---------- 腾讯云短信（注册/登录验证码） ----------
SMS_SECRET_ID=your_tencent_secret_id
SMS_SECRET_KEY=your_tencent_secret_key
SMS_SDK_APP_ID=your_sms_sdk_app_id
SMS_SIGN_NAME=your_sms_sign_name
SMS_TEMPLATE_ID=your_sms_template_id
# 托管短信转发：未配置上面 SMS_* 时的默认通道（卡世界托管，防刷限制见 docs/installation.md）
SMS_RELAY_URL=https://www.kashijie.com/open-api/platform/sms-relay
